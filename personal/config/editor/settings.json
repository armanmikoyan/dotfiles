{
  "files.autoSaveDelay": 0,
  "files.autoSave": "afterDelay",
  "workbench.iconTheme": "symbols",
  "notebook.undoRedoPerCell": false,
  "editor.cursorBlinking": "smooth",
  "terminal.integrated.cursorBlinking": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "security.workspace.trust.untrustedFiles": "open",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.detectIndentation": true,
  "editor.codeActionsOnSave": {
    "source.format.oxc": "always",
    "source.fixAll.oxc": "always"
  },
  "workbench.colorTheme": "Night Owl (No Italics)",
  "workbench.panel.showLabels": false,
  "workbench.panel.defaultLocation": "right",
  "editor.minimap.enabled": true,
  "window.commandCenter": true,
  "workbench.editor.enablePreview": false,
  "explorer.confirmDragAndDrop": false,
  "gitlens.graph.layout": "editor",
  "gitlens.rebaseEditor.openOnPausedRebase": false,
  "gitlens.views.searchAndCompare.pullRequests.showForCommits": false,
  "accessibility.signalOptions.volume": 0,
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.cache": true,
    "**/coverage": true,
    "**/.nyc_output": true,
    "**/*.min.js": true,
    "**/*.min.css": true,
    "**/*.map": true,
    "**/*.chunk.js": true,
    "**/*.bundle.js": true,
    "**/storybook-static": true,
    "**/__generated__": true,
    "**/generated": true,
    "**/*.snap": true,
    "**/package-lock.json": true,
    "**/yarn.lock": true,
    "**/pnpm-lock.yaml": true,
    "**/memory_bank": false
  },
  "files.exclude": {
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.git": true,
    "**/memory_bank": false,
    // Set to true to hide node_modules from the Explorer tree.
    "**/node_modules": false
  },
  "workbench.colorCustomizations": {
    "terminal.ansiBlack": "#14191e",
    "terminal.ansiRed": "#ff0000",
    "terminal.ansiGreen": "#00ff00",
    "terminal.ansiYellow": "#ffff00",
    "terminal.ansiBlue": "#5c8fff",
    "terminal.ansiMagenta": "#bf3fbd",
    "terminal.ansiCyan": "#00c5c7",
    "terminal.ansiWhite": "#c7c7c7",
    "terminal.ansiBrightBlack": "#676767",
    "terminal.ansiBrightRed": "#ff4444",
    "terminal.ansiBrightGreen": "#00ff00",
    "terminal.ansiBrightYellow": "#ece100",
    "terminal.ansiBrightBlue": "#a6aaf1",
    "terminal.ansiBrightMagenta": "#e07de0",
    "terminal.ansiBrightCyan": "#5ffdff",
    "terminal.ansiBrightWhite": "#feffff",
    "terminal.foreground": "#feffff"
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.hg/store/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/coverage/**": true,
    "**/.cache/**": true,
    "**/storybook-static/**": true,
    "**/memory_bank": false
  },
  "docker.extension.enableComposeLanguageServer": false,
  "oxc.enable": true,
  "oxc.lint.run": "onType",
  "oxc.requireConfig": false,
  "oxc.enable.oxfmt": true,
  "oxc.enable.oxlint": true,
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[scss]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[less]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "vscode.markdown-language-features"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "window.autoDetectColorScheme": false
}